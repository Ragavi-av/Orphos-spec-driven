<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.orphos.eip</groupId>
        <artifactId>eip-mvp-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>eip-agent-spec</artifactId>
    <name>eip-agent-spec</name>
    <description>Agent contract library (TO-BE design §5.2): manifests, invocation/approval
        envelopes, and self-registration payloads. DTOs and interfaces ONLY — no logic — so it can
        never couple one agent to another. Every agent and the orchestrator depend on this shared
        contract, never on a sibling module (invariants I1, I4).</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Jackson annotations only: the sealed Trigger hierarchy needs polymorphic
             (de)serialization metadata. No databind, no Spring — this stays a pure
             contract jar with no runtime framework coupling. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Library module: skip the inherited Spring Boot repackage goal. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
