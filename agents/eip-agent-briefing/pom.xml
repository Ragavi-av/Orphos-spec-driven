<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.orphos.eip</groupId>
        <artifactId>eip-mvp-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>eip-agent-briefing</artifactId>
    <name>eip-agent-briefing</name>
    <description>Standalone Briefing agent (TO-BE design §14): schedule-triggered, SUGGEST_ONLY. A
        thin Spring Boot app on eip-agent-runtime — it only declares its AgentManifest; the runtime
        provides the planner loop, MCP gateway, /invoke endpoint, and self-registration.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- The whole engine: planner loop + MCP gateway + /invoke + self-registration. -->
        <dependency>
            <groupId>io.orphos.eip</groupId>
            <artifactId>eip-agent-runtime</artifactId>
        </dependency>
        <!-- Internal-service token resolution from Infisical (self-registration + gateway calls). -->
        <dependency>
            <groupId>io.orphos.eip</groupId>
            <artifactId>eip-secrets</artifactId>
        </dependency>
        <!-- JWT + internal-token enforcement via the shared default SecurityFilterChain
             (protects /invoke + /approvals; the orchestrator authenticates with X-Internal-Token). -->
        <dependency>
            <groupId>io.orphos.eip</groupId>
            <artifactId>eip-core-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <exclusions>
                <!-- Logging is Log4j2 (see log4j2.xml), not the default Logback. -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
            <exclusions>
                <!-- Logging is Log4j2 (see log4j2.xml), not the default Logback. -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions>
                <!-- Logging is Log4j2 (see log4j2.xml), not the default Logback. -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- Logging is Log4j2 (see log4j2.xml), not the default Logback. -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Log4j2, replacing the Logback default excluded above. log4j2.xml owns the
             appenders and the JSON format; per-package levels stay in application.yml's
             logging.level.*, which Spring Boot applies to Log4j2 just as it did to Logback. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <!-- JsonTemplateLayout, for the JSON log output defined in log4j2-json-layout.json. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-layout-template-json</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
