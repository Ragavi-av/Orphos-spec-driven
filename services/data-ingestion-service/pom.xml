<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.orphos.eip</groupId>
    <artifactId>eip-mvp-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>data-ingestion-service</artifactId>
  <name>data-ingestion-service</name>
  <description>Enterprise data ingestion — connects to external enterprise data sources
      (JDBC databases and REST APIs), discovers their metadata, maps source columns to
      the tenant's ArcadeDB model, and runs scheduled or on-demand batch extract/load jobs.</description>

  <dependencies>
    <dependency>
      <groupId>io.orphos.eip</groupId>
      <artifactId>eip-secrets</artifactId>
    </dependency>
    <dependency>
      <groupId>io.orphos.eip</groupId>
      <artifactId>eip-common</artifactId>
    </dependency>
    <dependency>
      <groupId>io.orphos.eip</groupId>
      <artifactId>eip-core-security</artifactId>
    </dependency>
    <dependency>
      <groupId>io.orphos.eip</groupId>
      <artifactId>eip-core-arcadedb</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <!-- Logging is Log4j2 (see log4j2.xml), not the default Logback. -->
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
      <exclusions>
        <!-- Logging is Log4j2 (see log4j2.xml), not the default Logback. -->
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <exclusions>
        <!-- Logging is Log4j2 (see log4j2.xml), not the default Logback. -->
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- /actuator/prometheus scrape endpoint (job metrics, req 7.3) — same as doc-ingest -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
      <exclusions>
        <!-- Logging is Log4j2 (see log4j2.xml), not the default Logback. -->
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
      <exclusions>
        <!-- Logging is Log4j2 (see log4j2.xml), not the default Logback. -->
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- 24h metadata snapshot cache (Apache-2.0) -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- Zoho ERP batch pipeline (io.orphos.eip.dataingestion.zohobatch): chunk-oriented
         Job/Step, version managed by the Spring Boot parent BOM. Its JobRepository runs
         against the embedded H2 below, so no relational infra is added to the platform. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-batch</artifactId>
      <exclusions>
        <!-- Logging is Log4j2 (see log4j2.xml), not the default Logback. -->
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Camel route (direct:zohoFetchPage) that the Zoho batch step's ItemReader calls per
         page; the route itself delegates the actual HTTP+OAuth work to the existing
         ErpHttpClient/ErpTokenProvider via a .bean() step — Camel is the orchestration/
         redelivery layer here, not a reimplementation of Zoho's auth/pagination. -->
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-spring-boot-starter</artifactId>
    </dependency>

    <!-- Parses uploaded OpenAPI/Swagger JSON (2.0 + 3.x) for enterprise-system
         (REST_OPENAPI / ZOHO_ERP) sources: resolves $refs and turns operations
         into selectable objects. Apache-2.0. Not managed by the parent BOM, so
         an explicit version is pinned here. -->
    <dependency>
      <groupId>io.swagger.parser.v3</groupId>
      <artifactId>swagger-parser</artifactId>
      <version>2.1.22</version>
    </dependency>

    <!-- Connection pooling for external JDBC sources (Apache-2.0). Pulled directly
         (not via starter-jdbc) because this service manages one pool PER configured
         data source itself — Spring's single auto-configured DataSource is not used. -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>

    <!-- Bundled JDBC drivers, permissive licenses only (see OSS licensing policy):
         PostgreSQL (BSD-2-Clause), Microsoft SQL Server (MIT). Other databases —
         including MySQL (GPL, so not bundled) and ODBC bridges exposed as JDBC
         drivers — are supported through the GENERIC_JDBC source kind: drop the
         driver jar into /app/drivers (host ./drivers bind mount, appended to the
         classpath via loader.path) and set driverClass. See ../../drivers/README.md.
         MySQL example: mysql-connector-j-8.x.jar, driverClass com.mysql.cj.jdbc.Driver. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <!-- Logging is Log4j2 (see log4j2.xml), not the default Logback. -->
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- In-memory JDBC target for connection/discovery tests (EPL/MPL), AND — at runtime —
         the embedded database Spring Batch's JobRepository auto-configures against for the
         Zoho batch pipeline (io.orphos.eip.dataingestion.zohobatch). No longer test-scoped:
         Spring Boot's BatchAutoConfiguration needs it on the runtime classpath to build the
         embedded DataSource; it is never a persistent/shared datastore, so this doesn't add
         a relational-DB dependency to the platform the way a real Postgres/MySQL would. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>

    <!-- Log4j2, replacing the Logback default excluded above. log4j2.xml owns the
         appenders and the JSON format; per-package levels stay in application.yml's
         logging.level.*, which Spring Boot applies to Log4j2 just as it did to Logback. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-log4j2</artifactId>
    </dependency>
    <!-- JsonTemplateLayout, for the JSON log output defined in log4j2-json-layout.json. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-layout-template-json</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- ZIP layout enables PropertiesLauncher so extra JDBC driver jars can be
               added at runtime via loader.path=/app/drivers without rebuilding. -->
          <layout>ZIP</layout>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
