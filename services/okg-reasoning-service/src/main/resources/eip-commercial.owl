<?xml version="1.0"?>
<!--
  EIP Commercial Ontology — the revenue side: what we sell, to whom, what is in
  the pipeline, and what is under contract.

  Built on top of the ent:Client and ent:Engagement that eip-enterprise.owl
  already defines rather than introducing a parallel customer model. An
  Opportunity becomes a Contract; a Contract realises an ent:Engagement; revenue
  posted in eip-finance.owl attributes back to that same Engagement. So "what did
  this client cost us versus pay us" is one path through the graph, not a
  reconciliation exercise.

  Class-level owl:hasValue restrictions on gov:inDataDomain and
  gov:hasSensitivity make every instance self-classifying — see the header of
  eip-finance.owl for why that matters to RBAC.
-->
<rdf:RDF xmlns="http://orphos.eip/ontology/commercial#"
     xml:base="http://orphos.eip/ontology/commercial"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:ent="http://orphos.eip/ontology/enterprise#"
     xmlns:gov="http://orphos.eip/ontology/governance#"
     xmlns:com="http://orphos.eip/ontology/commercial#">

    <owl:Ontology rdf:about="http://orphos.eip/ontology/commercial"/>

    <!-- ============================ Classes ============================ -->

    <owl:Class rdf:about="http://orphos.eip/ontology/commercial#Product">
        <rdfs:label>Product</rdfs:label>
        <rdfs:comment>Something sold repeatedly. Public by default — the catalogue is
            usually outward-facing, unlike everything else in this file.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#inDataDomain"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#DomainCommercial"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#hasSensitivity"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#Public"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/commercial#ServiceLine">
        <rdfs:label>Service Line</rdfs:label>
        <rdfs:comment>A delivery capability sold as a service. Sits alongside
            ent:FunctionalArea (how we organise) as the commercial view (what we
            sell) — related but not the same axis.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#inDataDomain"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#DomainCommercial"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#hasSensitivity"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#Internal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/commercial#Opportunity">
        <rdfs:label>Opportunity</rdfs:label>
        <rdfs:comment>A potential deal with a weighted value. com:weightedValue is
            stored rather than derived so a stage's probability can change without
            silently rewriting history.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#inDataDomain"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#DomainPipeline"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#hasSensitivity"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#Confidential"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/commercial#PipelineSnapshot">
        <rdfs:label>Pipeline Snapshot</rdfs:label>
        <rdfs:comment>Aggregate pipeline by stage for an org unit in a period — what a
            dashboard reads instead of scanning every Opportunity.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#inDataDomain"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#DomainPipeline"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#hasSensitivity"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#Confidential"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/commercial#Quote">
        <rdfs:label>Quote</rdfs:label>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#inDataDomain"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#DomainPipeline"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#hasSensitivity"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#Confidential"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/commercial#Contract">
        <rdfs:label>Contract</rdfs:label>
        <rdfs:comment>A signed commitment. Realises an ent:Engagement, which is where
            delivery and finance meet it.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#inDataDomain"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#DomainContracts"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#hasSensitivity"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#Confidential"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/commercial#Renewal">
        <rdfs:label>Renewal</rdfs:label>
        <rdfs:comment>A contract's upcoming or completed renewal decision — the
            retention counterpart to Opportunity.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#inDataDomain"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#DomainContracts"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#hasSensitivity"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#Confidential"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/commercial#SatisfactionScore">
        <rdfs:label>Satisfaction Score</rdfs:label>
        <rdfs:comment>CSAT / NPS for a client in a period. Aggregate only — no
            respondent is identified, and no free-text comment is carried, because
            comments routinely contain names.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#inDataDomain"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#DomainCommercial"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://orphos.eip/ontology/governance#hasSensitivity"/>
                <owl:hasValue rdf:resource="http://orphos.eip/ontology/governance#Internal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ======================= Object Properties ======================= -->

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/commercial#forClient">
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Client"/>
        <rdfs:comment>No domain: opportunities, quotes, contracts, renewals and
            satisfaction scores all attach to a client.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/commercial#forProduct">
        <rdfs:range rdf:resource="http://orphos.eip/ontology/commercial#Product"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/commercial#inServiceLine">
        <rdfs:range rdf:resource="http://orphos.eip/ontology/commercial#ServiceLine"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/commercial#quoteForOpportunity">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#Quote"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/commercial#Opportunity"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/commercial#wonAsContract">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#Opportunity"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/commercial#Contract"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/commercial#contractRealisesEngagement">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#Contract"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Engagement"/>
        <rdfs:comment>The hinge between selling and delivering: finance attributes
            revenue to the Engagement, delivery attributes projects to it, and this
            property connects both to the signed Contract.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/commercial#renewalOfContract">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#Renewal"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/commercial#Contract"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/commercial#soldByOrgUnit">
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
    </owl:ObjectProperty>

    <!-- ========================= Data Properties ======================== -->

    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#externalId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#tenantId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#name">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#description">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#stage">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#Opportunity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>QUALIFY, PROPOSE, NEGOTIATE, WON, LOST.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#probability">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#Opportunity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#dealValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#weightedValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#expectedCloseDate">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#Opportunity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#contractValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#annualRecurringRevenue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#contractStatus">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#Contract"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>DRAFT, ACTIVE, EXPIRED, TERMINATED.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#signedDate">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#expiryDate">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#renewalOutcome">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#Renewal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>PENDING, RENEWED, UPSOLD, DOWNSOLD, CHURNED.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#pipelineValue">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#PipelineSnapshot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#opportunityCount">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#PipelineSnapshot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#winRate">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#PipelineSnapshot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#scoreType">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#SatisfactionScore"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>CSAT | NPS.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#scoreValue">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#SatisfactionScore"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/commercial#responseCount">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/commercial#SatisfactionScore"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>

</rdf:RDF>
