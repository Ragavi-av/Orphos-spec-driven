        <gov:inDataDomain rdf:resource="http://orphos.eip/ontology/governance#DomainItOperations"/>
        <gov:hasSensitivity rdf:resource="http://orphos.eip/ontology/governance#Internal"/>
        <gov:renderedBy rdf:resource="http://orphos.eip/ontology/governance#WidgetIncidents"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCto"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCoo"/>
    </gov:Metric>

    <gov:Metric rdf:about="http://orphos.eip/ontology/governance#MetricProjectsAtRisk">
