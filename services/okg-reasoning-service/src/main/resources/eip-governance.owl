        <gov:inDataDomain rdf:resource="http://orphos.eip/ontology/governance#DomainItOperations"/>
        <gov:hasSensitivity rdf:resource="http://orphos.eip/ontology/governance#Internal"/>
        <gov:renderedBy rdf:resource="http://orphos.eip/ontology/governance#WidgetSlaHealth"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCto"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCoo"/>
    </gov:Metric>

    <gov:Metric rdf:about="http://orphos.eip/ontology/governance#MetricSystemHealth">
        <gov:metricKey>it.systems.degraded</gov:metricKey>
        <gov:name>IT System Health</gov:name>
        <gov:unit>COUNT</gov:unit>
        <gov:aggregation>COUNT</gov:aggregation>
        <gov:higherIsBetter rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</gov:higherIsBetter>
        <gov:inDataDomain rdf:resource="http://orphos.eip/ontology/governance#DomainItOperations"/>
        <gov:hasSensitivity rdf:resource="http://orphos.eip/ontology/governance#Internal"/>
        <gov:renderedBy rdf:resource="http://orphos.eip/ontology/governance#WidgetSystemHealth"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCto"/>
    </gov:Metric>

    <gov:Metric rdf:about="http://orphos.eip/ontology/governance#MetricBudgetVariance">
        <gov:metricKey>fin.budget.variance</gov:metricKey>
        <gov:name>Budget Variance</gov:name>
        <gov:unit>CURRENCY</gov:unit>
        <gov:aggregation>SUM</gov:aggregation>
        <gov:higherIsBetter rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</gov:higherIsBetter>
        <gov:inDataDomain rdf:resource="http://orphos.eip/ontology/governance#DomainBudget"/>
        <gov:hasSensitivity rdf:resource="http://orphos.eip/ontology/governance#Confidential"/>
        <gov:renderedBy rdf:resource="http://orphos.eip/ontology/governance#WidgetBudgetVariance"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCfo"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCeo"/>
    </gov:Metric>

    <gov:Metric rdf:about="http://orphos.eip/ontology/governance#MetricHeadcount">
        <gov:metricKey>hr.headcount.total</gov:metricKey>
        <gov:name>Total Headcount</gov:name>
        <gov:unit>COUNT</gov:unit>
        <gov:aggregation>LAST</gov:aggregation>
        <gov:higherIsBetter rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</gov:higherIsBetter>
        <gov:inDataDomain rdf:resource="http://orphos.eip/ontology/governance#DomainHeadcount"/>
        <gov:hasSensitivity rdf:resource="http://orphos.eip/ontology/governance#Internal"/>
        <gov:renderedBy rdf:resource="http://orphos.eip/ontology/governance#WidgetHeadcount"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaChro"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCeo"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCoo"/>
    </gov:Metric>

    <gov:Metric rdf:about="http://orphos.eip/ontology/governance#MetricHeadcountByDept">
        <gov:metricKey>hr.headcount.by-dept</gov:metricKey>
        <gov:name>Headcount by Department</gov:name>
        <gov:unit>COUNT</gov:unit>
        <gov:aggregation>SUM</gov:aggregation>
        <gov:higherIsBetter rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</gov:higherIsBetter>
        <gov:inDataDomain rdf:resource="http://orphos.eip/ontology/governance#DomainHeadcount"/>
        <gov:hasSensitivity rdf:resource="http://orphos.eip/ontology/governance#Internal"/>
        <gov:renderedBy rdf:resource="http://orphos.eip/ontology/governance#WidgetHeadcountDept"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaChro"/>
    </gov:Metric>

    <gov:Metric rdf:about="http://orphos.eip/ontology/governance#MetricAnnualPayroll">
        <gov:metricKey>hr.payroll.annual</gov:metricKey>
        <gov:name>Annual Payroll</gov:name>
        <gov:unit>CURRENCY</gov:unit>
        <gov:aggregation>SUM</gov:aggregation>
        <gov:higherIsBetter rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</gov:higherIsBetter>
        <gov:inDataDomain rdf:resource="http://orphos.eip/ontology/governance#DomainPayroll"/>
        <gov:hasSensitivity rdf:resource="http://orphos.eip/ontology/governance#Confidential"/>
        <gov:renderedBy rdf:resource="http://orphos.eip/ontology/governance#WidgetPayroll"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCfo"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaChro"/>
        <gov:description>An AGGREGATE only — the sum of a compensation cost across a
            population, never a per-person figure. Confidential, not Restricted,
            precisely because it is an aggregate.</gov:description>
    </gov:Metric>

    <gov:Metric rdf:about="http://orphos.eip/ontology/governance#MetricNetCashflow">
        <gov:metricKey>fin.cashflow.net</gov:metricKey>
        <gov:name>Net Cash Flow</gov:name>
        <gov:unit>CURRENCY</gov:unit>
        <gov:aggregation>SUM</gov:aggregation>
        <gov:higherIsBetter rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</gov:higherIsBetter>
        <gov:inDataDomain rdf:resource="http://orphos.eip/ontology/governance#DomainTreasury"/>
        <gov:hasSensitivity rdf:resource="http://orphos.eip/ontology/governance#Confidential"/>
        <gov:renderedBy rdf:resource="http://orphos.eip/ontology/governance#WidgetNetCashflow"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCfo"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCeo"/>
    </gov:Metric>

    <gov:Metric rdf:about="http://orphos.eip/ontology/governance#MetricCashInflow">
        <gov:metricKey>fin.cashflow.inflow</gov:metricKey>
        <gov:name>Cash Inflow</gov:name>
        <gov:unit>CURRENCY</gov:unit>
        <gov:aggregation>SUM</gov:aggregation>
        <gov:higherIsBetter rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</gov:higherIsBetter>
        <gov:inDataDomain rdf:resource="http://orphos.eip/ontology/governance#DomainTreasury"/>
        <gov:hasSensitivity rdf:resource="http://orphos.eip/ontology/governance#Confidential"/>
        <gov:renderedBy rdf:resource="http://orphos.eip/ontology/governance#WidgetCashInflow"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCfo"/>
    </gov:Metric>

    <gov:Metric rdf:about="http://orphos.eip/ontology/governance#MetricCashOutflow">
        <gov:metricKey>fin.cashflow.outflow</gov:metricKey>
        <gov:name>Cash Outflow</gov:name>
        <gov:unit>CURRENCY</gov:unit>
        <gov:aggregation>SUM</gov:aggregation>
        <gov:higherIsBetter rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</gov:higherIsBetter>
        <gov:inDataDomain rdf:resource="http://orphos.eip/ontology/governance#DomainTreasury"/>
        <gov:hasSensitivity rdf:resource="http://orphos.eip/ontology/governance#Confidential"/>
        <gov:renderedBy rdf:resource="http://orphos.eip/ontology/governance#WidgetCashOutflow"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCfo"/>
    </gov:Metric>

    <!-- Metric ownership — who the number belongs to, distinct from who watches it. -->
    <gov:Persona rdf:about="http://orphos.eip/ontology/governance#PersonaCfo">
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricNetCashflow"/>
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricCashInflow"/>
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricCashOutflow"/>
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricBudgetVariance"/>
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricAnnualPayroll"/>
    </gov:Persona>
    <gov:Persona rdf:about="http://orphos.eip/ontology/governance#PersonaCto">
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricUptime"/>
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricSlaHealth"/>
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricSystemHealth"/>
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricActiveIncidents"/>
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricActiveAlerts"/>
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricItBudgetConsumed"/>
    </gov:Persona>
    <gov:Persona rdf:about="http://orphos.eip/ontology/governance#PersonaChro">
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricHeadcount"/>
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricHeadcountByDept"/>
    </gov:Persona>
    <gov:Persona rdf:about="http://orphos.eip/ontology/governance#PersonaCoo">
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricProjectsAtRisk"/>
    </gov:Persona>
    <gov:Persona rdf:about="http://orphos.eip/ontology/governance#PersonaCeo">
        <gov:accountableFor rdf:resource="http://orphos.eip/ontology/governance#MetricPendingDecisions"/>
    </gov:Persona>

</rdf:RDF>
