        <gov:unit>PERCENT</gov:unit>
        <gov:aggregation>LAST</gov:aggregation>
        <gov:higherIsBetter rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</gov:higherIsBetter>
        <gov:inDataDomain rdf:resource="http://orphos.eip/ontology/governance#DomainItSpend"/>
        <gov:hasSensitivity rdf:resource="http://orphos.eip/ontology/governance#Confidential"/>
        <gov:renderedBy rdf:resource="http://orphos.eip/ontology/governance#WidgetBudget"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCto"/>
        <gov:watchedBy rdf:resource="http://orphos.eip/ontology/governance#PersonaCfo"/>
    </gov:Metric>

    <gov:Metric rdf:about="http://orphos.eip/ontology/governance#MetricActiveIncidents">
        <gov:metricKey>it.incidents.active</gov:metricKey>
        <gov:name>Active Incidents</gov:name>
