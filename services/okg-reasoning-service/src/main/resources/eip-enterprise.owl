<?xml version="1.0"?>
<!--
  EIP Enterprise Ontology — the fixed schema describing an ENTERPRISE itself:
  the company, what it stands for (mission/vision/values), how it is organised
  (org units, executives, branches, locations) and who/what it serves
  (functional areas, industries, clients, engagements).

  This is a sibling of eip-core.owl (which models external work items such as
  Jira issues). It uses its own namespace so the two can be loaded side by side
  into the same Jena model without term collisions — see OntologyService, which
  reads eip-core.owl today; point reasoning.ontology-path at this file (or union
  both) to reason over enterprise facts.

  What is genuinely OWL-inferred here:
    - ent:reportsTo is a TransitiveProperty, so if A reportsTo B and B reportsTo
      C, the reasoner infers A reportsTo C — the full management chain without
      any Java walking it. ent:hasReport is its declared inverse, so the same
      closure is queryable downward ("everyone under C").
    - ent:subUnitOf is likewise transitive with inverse ent:hasSubUnit, giving
      the whole org-structure roll-up (a Team inside a Department inside a
      Division rolls up to the Division for free).

  PII note: Person/Executive deliberately carry only a displayName and jobTitle
  — no email, phone, or other personal identifiers — matching the PII-minimising
  convention already used on the graph side (see OkgGraphRepository.upsertPerson).
-->
<rdf:RDF xmlns="http://orphos.eip/ontology/enterprise#"
     xml:base="http://orphos.eip/ontology/enterprise"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:ent="http://orphos.eip/ontology/enterprise#">

    <owl:Ontology rdf:about="http://orphos.eip/ontology/enterprise"/>

    <!-- ============================ Classes ============================ -->

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#Company">
        <rdfs:label>Company</rdfs:label>
        <rdfs:comment>The enterprise being described — the root of the model.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#Mission">
        <rdfs:label>Mission</rdfs:label>
        <rdfs:comment>The company's mission — why it exists today.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#Vision">
        <rdfs:label>Vision</rdfs:label>
        <rdfs:comment>The company's vision — the future state it aims for.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#CoreValue">
        <rdfs:label>Core Value</rdfs:label>
        <rdfs:comment>A guiding principle the company upholds.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#FunctionalArea">
        <rdfs:label>Functional Area</rdfs:label>
        <rdfs:comment>A functional area of working, e.g. R&amp;D, Sales, Manufacturing, Consulting.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#Industry">
        <rdfs:label>Industry</rdfs:label>
        <rdfs:comment>An industry the company serves or operates in.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#Client">
        <rdfs:label>Client</rdfs:label>
        <rdfs:comment>An organisation the company delivers products or services to.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#Engagement">
        <rdfs:label>Engagement</rdfs:label>
        <rdfs:comment>A concrete relationship/contract/project with a client — the
            join that makes "who we serve, in which industry, delivered by which
            unit" a first-class, queryable thing rather than a loose link.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#Person">
        <rdfs:label>Person</rdfs:label>
        <rdfs:comment>An individual associated with the company. Carries no PII beyond a display name and title.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#Executive">
        <rdfs:subClassOf rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
        <rdfs:label>Executive</rdfs:label>
        <rdfs:comment>A key executive (C-suite, VP, director) — a Person, so it inherits reportsTo/memberOf.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#OrgUnit">
        <rdfs:label>Organisational Unit</rdfs:label>
        <rdfs:comment>A node in the org structure — Division, Department, or Team.
            Nests via subUnitOf to form the full hierarchy.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#Branch">
        <rdfs:label>Branch</rdfs:label>
        <rdfs:comment>A physical office/branch of the company (HQ, regional office, etc.).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/enterprise#Location">
        <rdfs:label>Location</rdfs:label>
        <rdfs:comment>A geographic location. Shared by Company (HQ), Branch, and Client.</rdfs:comment>
    </owl:Class>

    <!-- ======================= Object Properties ======================= -->

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#hasMission">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Mission"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#hasVision">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Vision"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#upholdsValue">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#CoreValue"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#operatesInArea">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#FunctionalArea"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#servesIndustry">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Industry"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#hasClient">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Client"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#hasEngagement">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Engagement"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#hasOrgUnit">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#hasBranch">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Branch"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#headquarteredAt">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Location"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#ledBy">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Executive"/>
    </owl:ObjectProperty>

    <!-- Org-structure hierarchy: transitive + inverse. Team subUnitOf Dept
         subUnitOf Division ⇒ reasoner infers Team subUnitOf Division, and via
         the inverse that Division hasSubUnit Team. Full roll-up, no Java. -->
    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#subUnitOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#hasSubUnit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <owl:inverseOf rdf:resource="http://orphos.eip/ontology/enterprise#subUnitOf"/>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#headedBy">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Executive"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#responsibleFor">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#FunctionalArea"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#memberOf">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#hasMember">
        <owl:inverseOf rdf:resource="http://orphos.eip/ontology/enterprise#memberOf"/>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
    </owl:ObjectProperty>

    <!-- Management chain: transitive + inverse. See file header. -->
    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#reportsTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#hasReport">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <owl:inverseOf rdf:resource="http://orphos.eip/ontology/enterprise#reportsTo"/>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
    </owl:ObjectProperty>

    <!-- locatedAt is intentionally left without an rdfs:domain: Branch, Client,
         and (optionally) OrgUnit all sit at a Location, and a single-class
         domain would let the reasoner mis-type any subject of locatedAt. -->
    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#locatedAt">
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Location"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#engagementWith">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Engagement"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Client"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#engagementInIndustry">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Engagement"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Industry"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#deliveredBy">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Engagement"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/enterprise#clientInIndustry">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Client"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Industry"/>
    </owl:ObjectProperty>

    <!-- ========================= Data Properties ======================== -->

    <!-- Shared identity/labels — no domain, reused across many classes
         (mirrors externalId/displayName in eip-core.owl). -->
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#externalId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#tenantId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#name">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#description">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#displayName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- Company -->
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#legalName">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#tradeName">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#foundedYear">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#registrationNumber">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#website">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#companyType">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>e.g. PRIVATE, PUBLIC, GOVERNMENT, NONPROFIT.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#stockSymbol">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#employeeCount">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#annualRevenue">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Company"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#currency">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>ISO 4217 currency code; used by Company (revenue) and Engagement (contract value).</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Mission / Vision / CoreValue -->
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#statement">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The wording of a Mission, Vision, or CoreValue.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Industry -->
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#sectorCode">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Industry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Standard classification code, e.g. NAICS or SIC.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Client -->
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#clientSince">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Client"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#clientTier">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Client"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>e.g. STRATEGIC, KEY, STANDARD.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#relationshipStatus">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Client"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>e.g. ACTIVE, PROSPECT, CHURNED.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Engagement -->
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#startDate">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Engagement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#endDate">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Engagement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#engagementStatus">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Engagement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>e.g. PROPOSED, ACTIVE, COMPLETED, CANCELLED.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#contractValue">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Engagement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <!-- Person / Executive (no PII beyond name + title) -->
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#jobTitle">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#appointedDate">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Executive"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <!-- OrgUnit -->
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#unitType">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>e.g. DIVISION, DEPARTMENT, TEAM.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#unitCode">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#OrgUnit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- Branch -->
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#branchType">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Branch"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>e.g. HEADQUARTERS, REGIONAL, SALES, RND, MANUFACTURING.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#openedDate">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Branch"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <!-- Location -->
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#addressLine">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#city">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#stateProvince">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#country">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/enterprise#postalCode">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/enterprise#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
