{
  "projectKey": "OT",

  "jql": {
    "storiesWithTestCases": "issuetype = Story AND status = Approved AND labels in (test-case-generated)",
    "storiesReadyForQA": "issuetype = Story AND status in (Approved, 'In Progress') AND created >= -7d"
  },

  "statusMapping": {
    "approved": "Ready for Production",
    "blocked": "Tests Failed",
    "inProgress": "QA In Progress"
  },

  "scoring": {
    "threshold": 90,
    "criticalCategories": {
      "tenant-isolation": 100,
      "security": 100,
      "data-integrity": 95,
      "payment": 100
    }
  },

  "execution": {
    "parallel": 4,
    "timeout": 300,
    "retryFlaky": 2,
    "browsers": ["chromium"],
    "recordVideo": "on-failure",
    "screenshot": "only-on-failure",
    "headless": true
  },

  "qaEnvironment": {
    "url": "https://qa.example.com",
    "apiBase": "https://api-qa.example.com",
    "dbHost": "qa-postgres.internal",
    "seedDataBeforeRun": true,
    "resetDataAfterRun": true,
    "dockerCompose": "docker-compose.qa.yml"
  },

  "playwrightGeneration": {
    "framework": "playwright",
    "typescript": true,
    "outputDir": "tests/e2e/generated",
    "templateDir": ".claude/skills/qa-agent/templates",
    "lineEndings": "LF",
    "indentation": 2
  },

  "reporting": {
    "dashboard": "https://qa-dashboard.example.com",
    "formats": ["html", "json"],
    "archiveResults": true,
    "resultsDir": "test-results",
    "resultsRetentionDays": 30
  },

  "notifications": {
    "slack": true,
    "slackChannel": "#qa-results",
    "jira": true,
    "email": false,
    "emailRecipients": []
  },

  "jiraUpdates": {
    "updateStoryStatus": true,
    "addLabels": true,
    "postComment": true,
    "createBugOnFailure": true,
    "bugProjectKey": "OT",
    "bugIssueType": "Bug",
    "linkTestResults": true,
    "linkType": "relates to"
  },

  "retryPolicy": {
    "flaky": 2,
    "timeout": 1,
    "network": 1
  },

  "testDataManagement": {
    "seedTestData": true,
    "testDataDir": "tests/data",
    "useTestDatabase": true,
    "resetBetweenTests": true,
    "preserveFailureData": true
  },

  "gating": {
    "enabled": true,
    "blockOnCriticalFailure": true,
    "requireApproval": false,
    "approvalRole": "qa-lead"
  }
}
