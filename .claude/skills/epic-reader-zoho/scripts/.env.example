# Copy to .env (same folder) and fill in. .env must stay gitignored - never commit it.

# Zoho API Console (https://api-console.zoho.com) -> Self Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Refresh token generated for the scopes:
# ZohoSprints.epic.ALL, ZohoSprints.items.ALL, ZohoSprints.projects.READ
ZOHO_REFRESH_TOKEN=

# Zoho Sprints team (portal) id
ZOHO_TEAM_ID=

# Data center: com | eu | in | com.au | jp
ZOHO_DOMAIN=com
