<?xml version="1.0"?>
<!--
  EIP Mobile Ontology — the executive's personal workspace on the native app:
  the notes they capture (Scribbles), the action items they track, the people
  they prioritise, the trips they take, the devices they carry, and how they
  want to be notified.

  ── Why this file is deliberately THIN ─────────────────────────────────────
  Unlike eip-finance.owl or eip-hr.owl, this ontology does NOT try to describe
  every attribute of its types. Its job is to state the RELATIONSHIPS that reach
  out of the mobile workspace into the shared enterprise graph — a Capture that
  is "about" a Decision, a Trip that lands at an ent:Location, an ActionItem
  that came from a MailInsight — so nl-query and the reasoner can traverse them.
  The bulk of each type's fields (bodies, summaries, timestamps, statuses) live
  as plain properties on the matching ArcadeDB DOCUMENT type, exactly as
  MailInsight and DocIngestRecord already do. Keep it that way: add an object
  property here only when it points at something the rest of the graph knows.

  ── A different access model: OWNER-SCOPED, not domain-classified ───────────
  Every other domain ontology stamps each class with gov:inDataDomain and
  gov:hasSensitivity so the persona/RBAC reasoner can grant it. These classes do
  NOT carry those restrictions on purpose. A Capture or an ActionItem is not
  shared reference data a persona is granted by role — it is personal to the
  ownerSub who created it, visible only to them and to whoever they explicitly
  share it with. That scoping ("tenantId = caller.tenant AND ownerSub =
  caller.sub, OR an explicit share exists") is enforced in the query layer, not
  by domain inference. Note the corollary: mob:relatesTo may point AT a
  Confidential Decision, but reading THAT decision still goes through the
  decision's own classification — linking to a thing never widens access to it.

  ── No PII beyond what already exists ──────────────────────────────────────
  People are referenced as ent:Person (display name + title only), never by a
  contact channel. mob:PriorityContact ranks people but stores no phone or
  email — the channel is resolved on-device from the OS/directory at send time.
  mob:Trip is city-/ent:Location-level, never a home or hotel address.
  mob:PushDevice stores an OpenBao REFERENCE to its push token, never the token.

  ── Bilingual, like eip-core.owl ───────────────────────────────────────────
  The app ships JA + EN, so classes and the key properties carry both labels;
  consumers pick with FILTER(langMatches(lang(?label), "ja")).

  ── Loading ────────────────────────────────────────────────────────────────
  Mirror this file into okg-reasoning-service/src/main/resources/ and append
  "classpath:eip-mobile.owl" to reasoning.ontology-paths in that service's
  application.yml (see the existing union list).
-->
<rdf:RDF xmlns="http://orphos.eip/ontology/mobile#"
     xml:base="http://orphos.eip/ontology/mobile"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:ent="http://orphos.eip/ontology/enterprise#"
     xmlns:eip="https://orphos.io/ontology/eip#"
     xmlns:mob="http://orphos.eip/ontology/mobile#">

    <owl:Ontology rdf:about="http://orphos.eip/ontology/mobile">
        <rdfs:comment>Personal mobile workspace — owner-scoped, thin (relationships
            only), bilingual. See file header.</rdfs:comment>
    </owl:Ontology>

    <!-- ============================ Classes ============================ -->

    <owl:Class rdf:about="http://orphos.eip/ontology/mobile#Capture">
        <rdfs:label xml:lang="en">Capture</rdfs:label>
        <rdfs:label xml:lang="ja">キャプチャ</rdfs:label>
        <rdfs:comment>A note captured on mobile — typed, dictated, photographed or
            handwritten — with its AI summary. Root of a Scribbles thread. Body,
            summary and thread live on the ArcadeDB Capture document type; only its
            links to people and business objects are modelled here.</rdfs:comment>
    </owl:Class>

    <!-- NOTE: there is deliberately NO mob:ActionItem here. The "Tasks for Action"
         tab is already backed by the mail-insight service: MailInsight rows with
         kind=TASK carry the status/priority/reminder the tab needs, and
         MailItemOverride carries a user's per-item action state for tasks that live
         in their source systems. Adding an ActionItem class would duplicate that
         store. A capture that should become an action links to it via
         mob:relatesTo rather than spawning a parallel task type. -->

    <owl:Class rdf:about="http://orphos.eip/ontology/mobile#Trip">
        <rdfs:label xml:lang="en">Trip</rdfs:label>
        <rdfs:label xml:lang="ja">出張</rdfs:label>
        <rdfs:comment>A business trip — feeds the Home "next travel in" line. Anchored
            to ent:Location at city level; never a home or hotel address.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/mobile#PriorityContact">
        <rdfs:label xml:lang="en">Priority Contact</rdfs:label>
        <rdfs:label xml:lang="ja">優先連絡先</rdfs:label>
        <rdfs:comment>A person the owner has flagged so their critical items break
            through notification quiet hours. Points at an ent:Person; stores a rank,
            not a phone or email — the channel is resolved on-device.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/mobile#NotificationPreference">
        <rdfs:label xml:lang="en">Notification Preference</rdfs:label>
        <rdfs:label xml:lang="ja">通知設定</rdfs:label>
        <rdfs:comment>One owner's notification settings — quiet hours, digest cadence,
            which categories are on, and whether critical items override quiet hours.
            Governs the two on-prem delivery tiers (push vs polling).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://orphos.eip/ontology/mobile#PushDevice">
        <rdfs:label xml:lang="en">Push Device</rdfs:label>
        <rdfs:label xml:lang="ja">プッシュデバイス</rdfs:label>
        <rdfs:comment>A registered device for push delivery. Holds an OpenBao reference
            to its APNs/FCM token, never the token itself.</rdfs:comment>
    </owl:Class>

    <!-- ======================= Object Properties =======================
         These are the reason the file exists: the edges that leave the personal
         workspace and land on the shared enterprise graph. -->

    <!-- Ownership. No rdfs:domain so every mobile class shares it, the way
         hr:snapshotForOrgUnit and ent:locatedAt are left domain-free. -->
    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/mobile#ownedBy">
        <rdfs:label xml:lang="en">owned by</rdfs:label>
        <rdfs:label xml:lang="ja">所有者</rdfs:label>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
        <rdfs:comment>The person who owns this workspace object. In storage this is the
            opaque Keycloak subject (ownerSub); resolved to an ent:Person for the
            graph. Shared by Capture, ActionItem, Trip, PriorityContact,
            NotificationPreference and PushDevice.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/mobile#capturedBy">
        <rdfs:label xml:lang="en">captured by</rdfs:label>
        <rdfs:label xml:lang="ja">作成者</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://orphos.eip/ontology/mobile#ownedBy"/>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/mobile#Capture"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
        <rdfs:comment>Author of a Capture — a sub-property of ownedBy, so the author is
            inferred to be an owner without a second assertion.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Polymorphic: a Capture can be ABOUT a Decision, an Incident, an
         Engagement, an OrgUnit or a MailInsight. Left without rdfs:range on
         purpose (see ent:locatedAt) so a single range can't mis-type the target. -->
    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/mobile#relatesTo">
        <rdfs:label xml:lang="en">relates to</rdfs:label>
        <rdfs:label xml:lang="ja">関連する</rdfs:label>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/mobile#Capture"/>
        <rdfs:comment>The business object a note is about. Polymorphic and range-free:
            a Decision, eip:Incident, ent:Engagement, ent:OrgUnit or MailInsight.
            Linking never widens access — the target keeps its own classification.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/mobile#mentions">
        <rdfs:label xml:lang="en">mentions</rdfs:label>
        <rdfs:label xml:lang="ja">言及する</rdfs:label>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/mobile#Capture"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
        <rdfs:comment>People named in a capture — display-name identity only.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/mobile#contactPerson">
        <rdfs:label xml:lang="en">contact person</rdfs:label>
        <rdfs:label xml:lang="ja">連絡先の人物</rdfs:label>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/mobile#PriorityContact"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
    </owl:ObjectProperty>

    <!-- Trip anchors to the shared ent:Location, not a free-text city, so a trip
         to an office branch joins the same place a Branch/Client sits at. -->
    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/mobile#destinationLocation">
        <rdfs:label xml:lang="en">destination</rdfs:label>
        <rdfs:label xml:lang="ja">目的地</rdfs:label>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/mobile#Trip"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Location"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/mobile#originLocation">
        <rdfs:label xml:lang="en">origin</rdfs:label>
        <rdfs:label xml:lang="ja">出発地</rdfs:label>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/mobile#Trip"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Location"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/mobile#tripForEngagement">
        <rdfs:label xml:lang="en">for engagement</rdfs:label>
        <rdfs:label xml:lang="ja">関連する契約</rdfs:label>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/mobile#Trip"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Engagement"/>
        <rdfs:comment>Ties a client-visit trip to the ent:Engagement it serves — so
            "travel spend against this engagement" stays answerable in one graph.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://orphos.eip/ontology/mobile#prefForPerson">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">preference for</rdfs:label>
        <rdfs:label xml:lang="ja">対象者</rdfs:label>
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/mobile#NotificationPreference"/>
        <rdfs:range rdf:resource="http://orphos.eip/ontology/enterprise#Person"/>
        <rdfs:comment>Functional: one preference record per person.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ========================= Data Properties ========================
         Thin on purpose — shared identity plus the few discriminators the graph
         reasons or filters on. Bodies, summaries, counts and timestamps stay on
         the ArcadeDB document types. -->

    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/mobile#externalId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/mobile#tenantId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/mobile#ownerSub">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Opaque Keycloak subject of the owner — the stored form of
            mob:ownedBy, and half of the owner-scoping predicate. Never a name.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/mobile#title">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/mobile#captureType">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/mobile#Capture"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>TEXT | VOICE | IMAGE | HANDWRITING.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://orphos.eip/ontology/mobile#captureStatus">
        <rdfs:domain rdf:resource="http://orphos.eip/ontology/mobile#Capture"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>DRAFT | PROCESSING | ACTIVE | ARCHIVED — PROCESSING covers the
            OCR/summarise step a handwriting or image capture passes through before
            its summary and key points exist.</rdfs:comment>
    </owl:DatatypeProperty>

</rdf:RDF>
