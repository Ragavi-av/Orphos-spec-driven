{
  "name": "eip-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "shell",
    "remotes/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=shell",
    "build:shell": "npm run build --workspace=shell",
    "build:all": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.3.6"
  }
}
