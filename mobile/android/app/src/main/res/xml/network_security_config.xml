<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dev only: allow cleartext to the locally-reversed Orphos stack. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- LAN IP of the dev host (EIP_PUBLIC_HOST): required because Keycloak
             rewrites the OIDC flow to this host, so the whole login must stay on it. -->
        <domain includeSubdomains="true">192.168.10.1</domain>
    </domain-config>
</network-security-config>
