<?xml version="1.0" encoding="utf-8"?>
<!-- CEO "Metrics" tab (company view). Only the chrome lives here; every card is built in
     CompanyMetricsFragment from CompanyMetrics, so no figures are baked into the layout. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="52dp"
        android:paddingBottom="120dp">

        <!-- Header: back, date · CEO view over the title, shared status dot + bell -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/cm_back"
                android:layout_width="36dp" android:layout_height="36dp"
                android:background="@drawable/card_bg_2"
                android:clickable="true" android:focusable="true"
                android:contentDescription="@string/nav_home">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back" app:tint="@color/text" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView
                    android:id="@+id/cm_subtitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/metric_label" android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/cm_title"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/nav_metrics"
                    android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold"
                    android:letterSpacing="-0.02" />
            </LinearLayout>
            <!-- Shared header (see HeaderActions): availability dot, bell -->
            <FrameLayout android:id="@+id/btn_status" android:layout_width="46dp" android:layout_height="38dp"
                android:background="@drawable/card_bg_2" android:clickable="true" android:focusable="true">
                <View android:id="@+id/status_dot" android:layout_width="11dp" android:layout_height="11dp" android:layout_gravity="center"
                    android:background="@drawable/circle_icon" android:backgroundTint="@color/status_busy" />
            </FrameLayout>
            <FrameLayout android:id="@+id/btn_bell" android:layout_width="46dp" android:layout_height="38dp"
                android:layout_marginStart="10dp" android:background="@drawable/card_bg_2"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                    android:src="@drawable/ic_bell" app:tint="@color/text" />
                <View android:id="@+id/bell_badge" android:visibility="gone"
                    android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="top|end"
                    android:layout_marginTop="9dp" android:layout_marginEnd="12dp"
                    android:background="@drawable/circle_icon" android:backgroundTint="@color/red" />
            </FrameLayout>
        </LinearLayout>

        <!-- Search (→ Ask Orphos) -->
        <LinearLayout
            android:id="@+id/cm_search"
            android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="16dp"
            android:background="@drawable/bg_segment" android:clickable="true" android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingHorizontal="14dp">
            <ImageView android:layout_width="17dp" android:layout_height="17dp"
                android:src="@drawable/ic_search" app:tint="@color/text_muted" />
            <EditText android:id="@+id/search_input" style="@style/SearchInput"
                android:layout_marginStart="10dp" android:hint="@string/cm_search_hint" />
            <ImageView android:id="@+id/search_orb" style="@style/SearchOrb"
                android:layout_width="24dp" android:layout_height="24dp" />
        </LinearLayout>

        <!-- Section tabs (segmented): Overview + the function tabs from the data -->
        <LinearLayout
            android:id="@+id/cm_tabs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:padding="4dp"
            android:background="@drawable/bg_segment" android:orientation="horizontal" />

        <!-- Quick tiles (OKRs, Board pack, Risks, Insights, Settings) — each opens a sheet -->
        <LinearLayout
            android:id="@+id/cm_tiles"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="horizontal" />

        <TextView
            android:id="@+id/cm_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center"
            android:text="@string/loading" android:textColor="@color/text_muted" android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/cm_content"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
