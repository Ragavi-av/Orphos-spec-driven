<?xml version="1.0" encoding="utf-8"?>
<!-- One AI Co-pilot session in the Advisors ▸ Search History list. Mirrors a session
     accordion in the web's History ▸ AI tab (ai-copilot/CopilotHistory.jsx): label,
     question count, start time and "ended"; tap to expand the Q&A and the delete action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/session_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/link" />

        <TextView
            android:id="@+id/session_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/session_count"
            style="@style/Chip.Soft"
            android:layout_marginStart="8dp"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/session_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/session_ended"
            style="@style/Chip.Soft"
            android:layout_marginStart="6dp"
            android:text="@string/copilot_history_ended"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/session_chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/session_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_soft" />

        <LinearLayout
            android:id="@+id/session_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_soft" />

        <ImageView
            android:id="@+id/session_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/copilot_history_delete_session"
            android:padding="9dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_muted" />
    </LinearLayout>
</LinearLayout>
