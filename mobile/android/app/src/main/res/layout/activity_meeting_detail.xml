<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/md_back" android:layout_width="26dp" android:layout_height="26dp"
                android:clickable="true" android:focusable="true"
                android:src="@drawable/ic_arrow_back" app:tint="@color/text" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/md_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/md_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textColor="@color/text_muted" android:textSize="12sp" />
            </LinearLayout>
            <!-- Shared header (see HeaderActions): availability dot, bell -->
            <FrameLayout android:id="@+id/btn_status" android:layout_width="46dp" android:layout_height="38dp"
                android:background="@drawable/card_bg_2" android:clickable="true" android:focusable="true">
                <View android:id="@+id/status_dot" android:layout_width="11dp" android:layout_height="11dp" android:layout_gravity="center"
                    android:background="@drawable/circle_icon" android:backgroundTint="@color/status_busy" />
            </FrameLayout>
            <FrameLayout android:id="@+id/btn_bell" android:layout_width="46dp" android:layout_height="38dp"
                android:layout_marginStart="10dp" android:background="@drawable/card_bg_2"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                    android:src="@drawable/ic_bell" app:tint="@color/text" />
                <View android:id="@+id/bell_badge" android:visibility="gone"
                    android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="top|end"
                    android:layout_marginTop="9dp" android:layout_marginEnd="12dp"
                    android:background="@drawable/circle_icon" android:backgroundTint="@color/red" />
            </FrameLayout>
        </LinearLayout>

        <!-- Chips -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="horizontal">
            <TextView android:id="@+id/md_time_chip" style="@style/Chip.Soft" android:visibility="gone"
                android:paddingHorizontal="12dp" android:paddingVertical="6dp"
                android:textColor="@color/link"
                android:backgroundTint="@color/blue_deep" android:textSize="11sp" />
            <TextView android:id="@+id/md_urgency_chip" style="@style/Chip.Soft" android:visibility="gone"
                android:layout_marginStart="8dp" android:paddingHorizontal="12dp" android:paddingVertical="6dp"
                android:text="@string/tag_urgent" android:textColor="@color/text_secondary"
                android:backgroundTint="@color/surface_3" android:textSize="11sp" />
        </LinearLayout>

        <!-- Attendees -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/md_attendees_count" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:fontFamily="sans-serif-medium" android:text=""
                android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/md_view_all" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/md_view_all" android:textColor="@color/link" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/md_attendees" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="horizontal" />

        <!-- AI Brief -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/ai_prompt_bg"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/orphos_orb" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium"
                    android:text="@string/md_ai_brief" android:textColor="@color/purple"
                    android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/md_brief" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Actions -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:fontFamily="sans-serif-medium"
            android:text="@string/md_actions" android:textColor="@color/text"
            android:textSize="17sp" android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/md_join"
            android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp"
            android:text="@string/md_join_meeting" android:textSize="15sp"
            app:backgroundTint="@color/primary" app:cornerRadius="14dp"
            app:icon="@drawable/ic_video" app:iconGravity="textStart" app:iconTint="@color/on_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/md_add_notes"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp"
            android:text="@string/md_add_notes" android:textColor="@color/link" android:textSize="15sp"
            app:cornerRadius="14dp" app:icon="@drawable/ic_scribbles" app:iconGravity="textStart"
            app:iconTint="@color/link" app:strokeColor="@color/border" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
