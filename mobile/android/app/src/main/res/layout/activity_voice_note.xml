<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/vn_back"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/vn_title"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live waveform (microphone level) + elapsed time of the recording -->
        <LinearLayout
            android:id="@+id/vn_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:id="@+id/vn_wave"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:gravity="center"
                android:orientation="horizontal" />
            <TextView
                android:id="@+id/vn_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:text="@string/vn_timer"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- What the screen is doing, and why it stopped when something failed -->
        <TextView
            android:id="@+id/vn_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg_2"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:padding="14dp"
            android:text="@string/vn_status_idle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/vn_record_again"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginEnd="12dp"
                android:text="@string/vn_record_again"
                android:textColor="@color/link"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="14dp"
                app:strokeColor="@color/border" />
            <!-- Recording / paused: Cancel · Pause|Resume · Done -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/vn_cancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="14dp"
                android:text="@string/cancel"
                android:textColor="@color/red"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="14dp"
                app:strokeColor="@color/border" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/vn_pause"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="14dp"
                android:text="@string/vn_pause"
                android:textColor="@color/link"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_pause"
                app:iconTint="@color/link"
                app:strokeColor="@color/border" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/vn_primary"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="@string/vn_record"
                android:textSize="15sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_mic"
                app:iconGravity="textStart"
                app:iconTint="@color/on_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_bg_2"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/text_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/ask_secure"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
