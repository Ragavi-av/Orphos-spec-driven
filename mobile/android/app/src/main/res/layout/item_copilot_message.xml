<?xml version="1.0" encoding="utf-8"?>
<!-- One question/answer pair, used both in the live Advisors answer card and inside an
     expanded history session. Question on the right, answer on the left, then a
     time · model footer, as in the web's CopilotHistory.jsx. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/msg_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="40dp"
        android:background="@drawable/bg_bubble_user"
        android:lineSpacingMultiplier="1.2"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/on_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/msg_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_bubble_ai"
        android:lineSpacingMultiplier="1.3"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="@color/text"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/msg_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:textColor="@color/text_muted"
        android:textSize="10sp" />

    <!-- Follow-up suggestions; only shown on the live card, where tapping one asks it. -->
    <LinearLayout
        android:id="@+id/msg_followups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
