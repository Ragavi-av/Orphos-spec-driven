<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="120dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/fin_back"
                android:layout_width="26dp" android:layout_height="26dp"
                android:clickable="true" android:focusable="true"
                android:src="@drawable/ic_arrow_back" app:tint="@color/text" />
            <TextView
                android:id="@+id/fin_title"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:text="@string/nav_financials"
                android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
            <!-- Shared header (see HeaderActions): availability dot, bell, search -->
            <FrameLayout android:id="@+id/btn_status" android:layout_width="46dp" android:layout_height="38dp"
                android:background="@drawable/card_bg_2" android:clickable="true" android:focusable="true">
                <View android:id="@+id/status_dot" android:layout_width="11dp" android:layout_height="11dp" android:layout_gravity="center"
                    android:background="@drawable/circle_icon" android:backgroundTint="@color/status_busy" />
            </FrameLayout>
            <FrameLayout android:id="@+id/btn_bell" android:layout_width="46dp" android:layout_height="38dp"
                android:layout_marginStart="10dp" android:background="@drawable/card_bg_2"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                    android:src="@drawable/ic_bell" app:tint="@color/text" />
                <View android:id="@+id/bell_badge" android:visibility="gone"
                    android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="top|end"
                    android:layout_marginTop="9dp" android:layout_marginEnd="12dp"
                    android:background="@drawable/circle_icon" android:backgroundTint="@color/red" />
            </FrameLayout>
        </LinearLayout>

        <!-- Search -->
        <LinearLayout
            android:id="@+id/fin_search"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp"
            android:background="@drawable/search_bg" android:clickable="true" android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingHorizontal="16dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_search" app:tint="@color/text_muted" />
            <EditText android:id="@+id/search_input" style="@style/SearchInput"
                android:layout_marginStart="12dp" android:hint="@string/fin_search_hint" />
            <ImageView android:id="@+id/search_orb" style="@style/SearchOrb" />
        </LinearLayout>

        <!-- Section tabs -->
        <HorizontalScrollView
            android:id="@+id/fin_tabs_scroll"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/fin_tab_dashboard" style="@style/FinTab"
                    android:background="@drawable/pill_active"
                    android:textColor="@color/on_primary" android:text="@string/fin_tab_dashboard" />
                <TextView android:id="@+id/fin_tab_pnl" style="@style/FinTab"
                    android:background="@drawable/pill_inactive"
                    android:textColor="@color/text_secondary" android:text="@string/fin_tab_pnl" />
                <TextView android:id="@+id/fin_tab_cashflow" style="@style/FinTab"
                    android:background="@drawable/pill_inactive"
                    android:textColor="@color/text_secondary" android:text="@string/fin_tab_cashflow" />
                <TextView android:id="@+id/fin_tab_expenses" style="@style/FinTab"
                    android:background="@drawable/pill_inactive"
                    android:textColor="@color/text_secondary" android:text="@string/fin_tab_expenses" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Quick actions -->
        <HorizontalScrollView
            android:id="@+id/fin_quick_scroll"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout style="@style/QuickTile">
                    <ImageView style="@style/QuickIcon" android:src="@drawable/ic_trending" />
                    <TextView style="@style/QuickLabel" android:text="@string/fin_forecasts" />
                </LinearLayout>
                <LinearLayout style="@style/QuickTile">
                    <ImageView style="@style/QuickIcon" android:src="@drawable/ic_note" />
                    <TextView style="@style/QuickLabel" android:text="@string/fin_reports" />
                </LinearLayout>
                <LinearLayout style="@style/QuickTile">
                    <ImageView style="@style/QuickIcon" android:src="@drawable/ic_help" />
                    <TextView style="@style/QuickLabel" android:text="@string/fin_tax" />
                </LinearLayout>
                <LinearLayout style="@style/QuickTile">
                    <ImageView style="@style/QuickIcon" android:src="@drawable/ic_bulb" />
                    <TextView style="@style/QuickLabel" android:text="@string/fin_insights" />
                </LinearLayout>
                <LinearLayout style="@style/QuickTile">
                    <ImageView style="@style/QuickIcon" android:src="@drawable/ic_settings" />
                    <TextView style="@style/QuickLabel" android:text="@string/fin_settings2" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Role widgets (CHRO Resource / COO Operations) — populated for non-finance roles -->
        <LinearLayout
            android:id="@+id/fin_role_widgets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Finance sections: built in FinancialsFragment from /api/mobile/financials
             (cashflow summary, budget overruns, widget persona metrics). No figures live
             in this layout, so a missing value shows as an empty state, never a sample. -->
        <TextView
            android:id="@+id/fin_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center"
            android:text="@string/loading" android:textColor="@color/text_muted" android:textSize="13sp" />
        <LinearLayout
            android:id="@+id/fin_section_dashboard"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <LinearLayout
            android:id="@+id/fin_section_pnl"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" />
        <LinearLayout
            android:id="@+id/fin_section_cashflow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" />
        <LinearLayout
            android:id="@+id/fin_section_expenses"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
