<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/detail_back" android:layout_width="26dp" android:layout_height="26dp"
                    android:clickable="true" android:focusable="true"
                    android:src="@drawable/ic_arrow_back" app:tint="@color/text" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="12dp" android:text="@string/detail_title"
                    android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
                <!-- Shared header (see HeaderActions): availability dot, bell -->
                <FrameLayout android:id="@+id/btn_status" android:layout_width="46dp" android:layout_height="38dp"
                    android:background="@drawable/card_bg_2" android:clickable="true" android:focusable="true">
                    <View android:id="@+id/status_dot" android:layout_width="11dp" android:layout_height="11dp" android:layout_gravity="center"
                        android:background="@drawable/circle_icon" android:backgroundTint="@color/status_busy" />
                </FrameLayout>
                <FrameLayout android:id="@+id/btn_bell" android:layout_width="46dp" android:layout_height="38dp"
                    android:layout_marginStart="10dp" android:background="@drawable/card_bg_2"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                        android:src="@drawable/ic_bell" app:tint="@color/text" />
                    <View android:id="@+id/bell_badge" android:visibility="gone"
                        android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="top|end"
                        android:layout_marginTop="9dp" android:layout_marginEnd="12dp"
                        android:background="@drawable/circle_icon" android:backgroundTint="@color/red" />
                </FrameLayout>
            </LinearLayout>

            <!-- Priority chip -->
            <TextView
                android:id="@+id/detail_urgency"
                style="@style/Chip.Soft"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:backgroundTint="@color/red_deep"
                android:textAllCaps="true"
                android:textColor="@color/red"
                android:textSize="11sp"
                tools:ignore="MissingPrefix" />

            <!-- Decision title -->
            <TextView
                android:id="@+id/detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Approve Q3 marketing budget increase" />

            <TextView
                android:id="@+id/detail_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                tools:text="Pending · AI 87% · Risk: Medium" />

            <!-- Description card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/detail_context"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    tools:text="Marketing requests a 20% budget increase to accelerate the Q3 product launch campaign." />
            </LinearLayout>

            <!-- AI Analysis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/ai_prompt_bg"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/orphos_orb" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium"
                        android:text="@string/detail_analysis" android:textColor="@color/purple"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/analysis_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    tools:text="The requested increase aligns with revenue targets and historical campaign ROI." />
            </LinearLayout>

            <!-- Key Impacts -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/detail_key_impacts"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/impacts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Recommendations -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/detail_recommendations"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/recommendations_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_reject"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/decision_reject"
            android:textColor="@color/red"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_approve"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/decision_approve"
            android:textSize="15sp"
            app:backgroundTint="@color/green"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_check_circle"
            app:iconGravity="textStart"
            app:iconTint="@color/on_primary" />
    </LinearLayout>
</LinearLayout>
