<?xml version="1.0" encoding="utf-8"?>
<!-- Glowing orb FAB container: rounded square, deep-purple fill + glow stroke. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="135"
        android:startColor="#241640"
        android:endColor="#120C24"
        android:type="linear" />
    <stroke android:width="1.5dp" android:color="@color/brand_glow" />
</shape>
